# Copy to .env.local (dev) or set in the host's env settings (production).
# All values are server-side only. Without the SMTP settings, every lead
# form returns HTTP 500.

# --- SMTP (required) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- SMTP (optional) ---
# Transport is hard-coded to secure: true, so this must be an SSL port (465).
SMTP_PORT=465

# Lead notifications go to helper@touchdomain.co.za, hardcoded in
# src/lib/mailer.ts — there is no ADMIN_EMAIL env var anymore.

# Optional override for the white logo in branded emails. Leave unset — the
# code default is correct. If you do set it, it MUST be the www host (the
# apex redirects, and email clients don't follow redirects on images).
# APP_LOGO_URL=https://www.touchdomain.co.za/branding/touch-domain-logo-onlight.png

# --- Site URL (required for every portal email link) ---
# Absolute base URL of THIS deployment. Used to build links in invite,
# contract, invoice and milestone emails. Local dev: http://localhost:3000.
# Production: https://www.touchdomain.co.za
# Also add "<this-url>/**" to Supabase -> Auth -> URL Configuration ->
# Redirect URLs, and set it as the Site URL there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required for the client/staff portal) ---
# URL + anon key: Project Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: Project Settings → API → service_role. SERVER ONLY —
# never expose. Used by admin server actions to provision clients, issue
# invoices, and manage projects (bypasses RLS after an admin check).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive (required for portal files, invoices, contracts) ---
# JWT service account with the Drive API enabled.
GOOGLE_CLIENT_EMAIL=
# The full PEM. In .env.local wrap it in double quotes and keep the literal
# \n escapes on one line; the code normalises them. In Vercel paste the real
# multi-line key into the value box.
GOOGLE_PRIVATE_KEY=
# The ID of a Google SHARED DRIVE (not a My Drive folder — service accounts
# have no storage quota, so uploads into a normal folder fail). Create a
# Shared Drive, add GOOGLE_CLIENT_EMAIL as a Content manager, use its ID.
# Required for any Drive feature to work.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- WHMCS / HostAfrica reseller (optional — hosting provisioning) ---
# Only needed once the HostAfrica reseller account is set up. Without these,
# the admin "Hosting (HostAfrica)" panel just shows "not configured" — every
# other portal feature works fine without it.
# Base URL of the WHMCS install, no trailing slash, e.g. https://billing.touchdomain.co.za
WHMCS_API_URL=
# Setup -> Staff -> API Credentials -> create an "API Access Key".
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
