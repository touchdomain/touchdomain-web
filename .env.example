# Copy to .env.local (dev) or set in the host's env settings (production).
# All values are server-side only. Without the SMTP settings, every lead
# form returns HTTP 500.

# --- SMTP (required) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- SMTP (optional) ---
# Transport is hard-coded to secure: true, so this must be an SSL port (465).
SMTP_PORT=465

# Lead notifications go to helper@touchdomain.co.za, hardcoded in
# src/lib/mailer.ts — there is no ADMIN_EMAIL env var anymore.

# Optional override for the white logo in branded emails. Leave unset — the
# code default is correct. If you do set it, it MUST be the www host (the
# apex redirects, and email clients don't follow redirects on images).
# APP_LOGO_URL=https://www.touchdomain.co.za/branding/touch-domain-logo-white.png
