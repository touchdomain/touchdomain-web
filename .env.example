# Copy to .env.local (dev) or set in the host's env settings (production).
# All values are server-side only. Without the SMTP settings, every lead
# form returns HTTP 500.

# --- SMTP (required) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- SMTP (optional) ---
# Transport is hard-coded to secure: true, so this must be an SSL port (465).
SMTP_PORT=465

# Lead notifications go to helper@touchdomain.co.za, hardcoded in
# src/lib/mailer.ts — there is no ADMIN_EMAIL env var anymore.

# Optional override for the white logo in branded emails. Leave unset — the
# code default is correct. If you do set it, it MUST be the www host (the
# apex redirects, and email clients don't follow redirects on images).
# APP_LOGO_URL=https://www.touchdomain.co.za/branding/touch-domain-logo-onlight.png

# --- Supabase (required for the client/staff portal) ---
# URL + anon key: Project Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: Project Settings → API → service_role. SERVER ONLY —
# never expose. Used by admin server actions to provision clients, issue
# invoices, and manage projects (bypasses RLS after an admin check).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive (required for portal file uploads + invoice filing) ---
# JWT service account with the Drive API enabled. Share the target folder
# with GOOGLE_CLIENT_EMAIL as Editor.
GOOGLE_CLIENT_EMAIL=
# Paste the full PEM. Keep the literal \n escapes if your host needs them;
# the code normalises them.
GOOGLE_PRIVATE_KEY=
# Optional. Default parent folder for uploads when a project has no
# google_drive_folder_id of its own. Leave unset to upload to the service
# account's Drive root.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
