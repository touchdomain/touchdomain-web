# Copy to .env.local (dev) or set in the host's env settings (production).
# All values are server-side only. Without the SMTP settings, every lead
# form returns HTTP 500.

# --- SMTP (required) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- SMTP (optional) ---
# Transport is hard-coded to secure: true, so this must be an SSL port (465).
SMTP_PORT=465

# --- Email routing (optional but recommended in production) ---
# Inbox that receives all lead notifications.
ADMIN_EMAIL=helper@touchdomain.co.za

# Absolute, publicly reachable URL of the logo used in branded emails.
APP_LOGO_URL=https://touchdomain.co.za/branding/logo-nav.png
